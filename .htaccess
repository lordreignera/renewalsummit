<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose application code, dependencies, configuration, or secrets
    # when the project root is accidentally configured as the web root.
    RewriteRule ^(?:\.env(?:\..*)?|composer\.(?:json|lock)|package(?:-lock)?\.json|artisan|vendor(?:/|$)|storage(?:/|$)) - [F,L,NC]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
